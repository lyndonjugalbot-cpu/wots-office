# Copy to .env and fill in as each phase needs them. Never commit .env.
ANTHROPIC_API_KEY=
# Needed only if your key isn't scoped to a workspace (the API will say so)
ANTHROPIC_WORKSPACE_ID=
# Encrypts per-office integration secrets. Generate one with:
#   .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_KEY=
# The internal office's owner and CEO, created by the v2 migration
WOTS_OWNER_EMAIL=
WOTS_OWNER_NAME=
# Off by default (Google's terms forbid storing Places data for lead lists). Leave empty.
GOOGLE_PLACES_KEY=
# Free: developer.company-information.service.gov.uk (UK lead search + entity checks)
COMPANIES_HOUSE_KEY=
# Free: abr.business.gov.au -> Tools -> Web services (AU ABN checks)
ABN_GUID=
VERCEL_TOKEN=
EMAIL_PROVIDER_KEY=
NOTIFY_WEBHOOK=
# true (default) = no external sends, no deploys, LLM spend capped at dry_run_llm_cap_usd
DRY_RUN=true
